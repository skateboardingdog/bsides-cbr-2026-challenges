extends layout

block content
  .container
    .card
      .brand
        .brand-icon
          svg(viewBox="0 0 24 24")
            path(d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z")
        h1 Welcome Back
        p Please sign in to your account

      if error
        .alert.alert-danger= error

      if success
        .alert.alert-success= success

      form(action="/login", method="POST")
        .form-group
          label(for="username") Username
          .input-wrapper
            input#username.input-control(type="text", name="username", placeholder="Enter your username", required, autofocus)

        .form-group
          label(for="password") Password
          .input-wrapper
            input#password.input-control(type="password", name="password", placeholder="••••••••", required)

        button.btn(type="submit") Sign In

      .auth-footer
        span Don't have an account? 
        a(href="/register") Register here
