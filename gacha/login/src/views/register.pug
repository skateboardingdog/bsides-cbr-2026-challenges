extends layout

block content
  .container
    .card
      .brand
        .brand-icon
          svg(viewBox="0 0 24 24")
            path(d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z")
        h1 Create Account
        p Join us today and get started

      if error
        .alert.alert-danger= error

      form(action="/register", method="POST")
        .form-group
          label(for="username") Username
          .input-wrapper
            input#username.input-control(type="text", name="username", placeholder="Choose a username", required, autofocus)

        .form-group
          label(for="password") Password
          .input-wrapper
            input#password.input-control(type="password", name="password", placeholder="••••••••", required)

        button.btn(type="submit") Create Account

      .auth-footer
        span Already have an account? 
        a(href="/login") Log in here
